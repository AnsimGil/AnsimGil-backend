# Keep empty for keyless Demo mode. Add the real value only in .env.local.
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice

# LIVE 장소 검색용 Google Places API (New) 키. 앱과 제출물에는 넣지 않습니다.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1

# M7: demo is the submission-safe default. Keep the real map key local only.
FLOOD_MAP_MODE=demo
# Set these only after the official WMS endpoint and layer are confirmed.
FLOOD_MAP_WMS_URL=
FLOOD_MAP_WMS_LAYER=
# Never commit or share the real public-data service key.
FLOOD_MAP_SERVICE_KEY=

# M4: obtain this service key from safetydata.go.kr. Never commit or share the real value.
DISASTER_DATA_SERVICE_KEY=
DISASTER_DATA_BASE_URL=https://www.safetydata.go.kr
DISASTER_DATA_INTERFACE_ID=DSSP-IF-00247
# Keep false until the service key has been entered locally and live mapping is verified.
DISASTER_DATA_USE_LIVE=false
DISASTER_DATA_MAX_ROWS=20
# crtDt 조회 시작일: 1 means today and the previous day (Korea time).
DISASTER_DATA_LOOKBACK_DAYS=1

# M6.5: obtain this key from the KMA short-term forecast service. Never commit the real value.
KMA_WEATHER_SERVICE_KEY=
KMA_WEATHER_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
# Keep false for keyless reproducible fixture mode. Set true only for local live verification.
KMA_WEATHER_USE_LIVE=false
KMA_WEATHER_NUM_OF_ROWS=1000

# M10: submission-safe defaults. These modes can also be selected per request.
ANSIMGIL_M10_ROUTE_MODE=demo
ANSIMGIL_M10_DATA_MODE=demo
ANSIMGIL_M10_PUSH_MODE=demo
# Optional local override for the Expo Push Service endpoint.
EXPO_PUSH_BASE_URL=https://exp.host/--/api/v2/push/send
